# For local LAN use leave this at :80. For public HTTPS use a DNS name.
SITE_ADDRESS=:80
SPIELRAUM_SEED_PREVIEW=true
SPIELRAUM_SIMULATIONS=50000
SPIELRAUM_MCMC_ITER=5000
SPIELRAUM_MCMC_BURNIN=1000
SPIELRAUM_MCMC_THIN=10
SPIELRAUM_ALLOW_EARLY_MARKET_VALUES=true

# Adapters print one JSON object as their final stdout line.
# See PORTFOLIO_SITE.md for the response contracts.
SPIELRAUM_RESULTS_COMMAND=python -m spielraum.adapters.results_openligadb --season 2026
SPIELRAUM_MODEL_COMMAND=python -m spielraum.adapters.model_v2 --season 2026
